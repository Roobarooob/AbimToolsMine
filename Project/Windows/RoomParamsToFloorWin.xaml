<?xml version="1.0" encoding="utf-8"?>
<Window x:Class="AbimToolsMine.RoomParamsToFloorWin"
  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="Передача параметров из помещений в элементы отделки"
    Width="600" Height="600" MinWidth="480" MinHeight="440"
    ResizeMode="CanResizeWithGrip"
    WindowStyle="SingleBorderWindow"
    Background="WhiteSmoke"
    Topmost="True">
    <Grid Margin="10">
        <Grid.RowDefinitions>
     <RowDefinition Height="Auto"/>
   <RowDefinition Height="*"/>
         <RowDefinition Height="Auto"/>
   <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Заголовок -->
        <TextBlock Grid.Row="0" Margin="0,0,0,8" FontWeight="SemiBold" FontSize="13"
            Text="Соответствие параметров: Помещение → Элемент отделки"/>

        <!-- Таблица маппинга -->
        <DataGrid Grid.Row="1"
            x:Name="DgMappings"
            AutoGenerateColumns="False"
        CanUserAddRows="True"
            CanUserDeleteRows="True"
     CanUserReorderColumns="False"
   CanUserSortColumns="False"
            HeadersVisibility="Column"
       GridLinesVisibility="Horizontal"
      BorderThickness="1"
       BorderBrush="#CCCCCC"
 Background="White"
   RowBackground="White"
            AlternatingRowBackground="#F7F7F7"
  Margin="0,0,0,8">
          <DataGrid.Columns>
 <DataGridTextColumn Header="Параметр помещения (источник)"
  Binding="{Binding SourceParam, UpdateSourceTrigger=PropertyChanged}"
           Width="*"/>
    <DataGridTextColumn Header="Параметр элемента отделки (цель)"
  Binding="{Binding TargetParam, UpdateSourceTrigger=PropertyChanged}"
     Width="*"/>
            </DataGrid.Columns>
        </DataGrid>

     <!-- Категории элементов -->
    <GroupBox Grid.Row="2" Header="Категории элементов отделки" Margin="0,0,0,8" Padding="8,4,8,6">
            <StackPanel Orientation="Horizontal">
      <CheckBox x:Name="CbFloors"
  Content="Полы"
    IsChecked="True"
             VerticalAlignment="Center"
         Margin="0,0,20,0"/>
    <CheckBox x:Name="CbCeilings"
       Content="Потолки"
           IsChecked="True"
  VerticalAlignment="Center"
           Margin="0,0,20,0"/>
       <CheckBox x:Name="CbWalls"
    Content="Стены"
        IsChecked="True"
             VerticalAlignment="Center"/>
            </StackPanel>
        </GroupBox>

    <!-- Выбор помещений -->
        <GroupBox Grid.Row="3" Header="Помещения" Margin="0,0,0,8" Padding="8,4,8,6">
      <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/>
           <RowDefinition Height="Auto"/>
           </Grid.RowDefinitions>
                <StackPanel Grid.Row="0" Orientation="Horizontal">
         <RadioButton x:Name="RbAllRooms"
            Content="Все помещения"
      IsChecked="True"
     VerticalAlignment="Center"
   Checked="OnRoomModeChanged"/>
  <RadioButton x:Name="RbSelectedRooms"
           Content="Выбранные помещения"
           Margin="16,0,0,0"
   VerticalAlignment="Center"
     Checked="OnRoomModeChanged"/>
   </StackPanel>
<StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,6,0,0"
x:Name="PanelRoomPick"
          Visibility="Collapsed">
       <Button x:Name="BtnPickRooms"
             Content="Выбрать на виде..."
       Width="140" Height="26" Margin="0,0,10,0"
       Click="OnPickRoomsClick"/>
             <TextBlock x:Name="TbRoomCount"
      VerticalAlignment="Center"
     FontStyle="Italic" Foreground="Gray"
        Text="Помещения не выбраны"/>
       </StackPanel>
   </Grid>
  </GroupBox>

        <!-- Кнопки -->
        <Grid Grid.Row="4">
<Grid.ColumnDefinitions>
      <ColumnDefinition Width="*"/>
     <ColumnDefinition Width="Auto"/>
         </Grid.ColumnDefinitions>

            <!-- Статус + запуск -->
      <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
      <TextBlock x:Name="TbStatus"
      Foreground="OrangeRed" FontStyle="Italic" FontSize="11"
         TextWrapping="Wrap" VerticalAlignment="Center"/>
          </StackPanel>

  <StackPanel Grid.Column="1" Orientation="Horizontal">
    <Button Content="Запустить"
         Width="90" Height="30" Margin="0,0,6,0"
             Background="#E8F4E8" BorderBrush="#4CAF50" BorderThickness="1.5"
    FontWeight="SemiBold"
    Click="OnRunClick"/>
<Button Content="Сбросить" Width="80" Height="30" Margin="0,0,6,0"
  Click="OnResetClick"/>
         <Button Content="Закрыть" Width="80" Height="30"
 Click="OnCancelClick"/>
            </StackPanel>
        </Grid>
    </Grid>
</Window>
