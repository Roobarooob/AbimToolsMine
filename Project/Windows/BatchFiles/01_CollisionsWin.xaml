<Window x:Class="AbimToolsMine.CollisionsWin"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Пакетная обработка" Width="820" Height="650" MinWidth="720" MinHeight="560"
        WindowStartupLocation="CenterScreen" ResizeMode="CanResizeWithGrip"
        Background="#F5F6F8" FontFamily="Segoe UI" FontSize="12" Closing="Window_Closing">

    <Window.Resources>
        <SolidColorBrush x:Key="TextBrush" Color="#2C3E50"/>
        <SolidColorBrush x:Key="MutedTextBrush" Color="#66727E"/>
        <SolidColorBrush x:Key="BorderBrush" Color="#D8DDE3"/>
        <SolidColorBrush x:Key="PrimaryBrush" Color="#27AE60"/>
        <SolidColorBrush x:Key="DangerBrush" Color="#C85A5A"/>

        <Style x:Key="CardGroupBoxStyle" TargetType="GroupBox">
            <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="GroupBox">
                        <Border Background="White" BorderBrush="{StaticResource BorderBrush}"
                                BorderThickness="1" CornerRadius="5">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="*"/>
                                </Grid.RowDefinitions>
                                <Border Padding="12,8" Background="#F8F9FA"
                                        BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1"
                                        CornerRadius="5,5,0,0">
                                    <ContentPresenter ContentSource="Header"/>
                                </Border>
                                <ContentPresenter Grid.Row="1" Margin="12,10" TextElement.FontWeight="Normal"/>
                            </Grid>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ButtonBaseStyle" TargetType="Button">
            <Setter Property="Height" Value="32"/>
            <Setter Property="MinWidth" Value="108"/>
            <Setter Property="Padding" Value="12,0"/>
            <Setter Property="Background" Value="White"/>
            <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
            <Setter Property="BorderBrush" Value="#C8CED6"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="FontFamily" Value="Segoe UI"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="ButtonBorder" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="4" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                              VerticalAlignment="{TemplateBinding VerticalContentAlignment}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ButtonBorder" Property="Background" Value="#EEF3F7"/>
                                <Setter TargetName="ButtonBorder" Property="BorderBrush" Value="#9EABB7"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="ButtonBorder" Property="Opacity" Value="0.72"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="ButtonBorder" Property="Opacity" Value="0.5"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ToolbarButtonStyle" TargetType="Button" BasedOn="{StaticResource ButtonBaseStyle}">
            <Setter Property="Margin" Value="0,0,8,0"/>
        </Style>
        <Style x:Key="PathButtonStyle" TargetType="Button" BasedOn="{StaticResource ButtonBaseStyle}">
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="Foreground" Value="#2471A3"/>
        </Style>
        <Style x:Key="ExecuteButtonStyle" TargetType="Button" BasedOn="{StaticResource ButtonBaseStyle}">
            <Setter Property="MinWidth" Value="145"/>
            <Setter Property="Background" Value="{StaticResource PrimaryBrush}"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="ActionBorder" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="4" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ActionBorder" Property="Opacity" Value="0.86"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="ActionBorder" Property="Opacity" Value="0.7"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="DangerButtonStyle" TargetType="Button" BasedOn="{StaticResource ExecuteButtonStyle}">
            <Setter Property="Background" Value="{StaticResource DangerBrush}"/>
        </Style>
        <Style x:Key="SettingsButtonStyle" TargetType="Button" BasedOn="{StaticResource ButtonBaseStyle}">
            <Setter Property="Width" Value="32"/>
            <Setter Property="MinWidth" Value="32"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="FontFamily" Value="Segoe MDL2 Assets"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Foreground" Value="#66727E"/>
        </Style>
        <Style x:Key="RemoveButtonStyle" TargetType="Button">
            <Setter Property="Width" Value="24"/>
            <Setter Property="Height" Value="24"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#C0392B"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="FontSize" Value="16"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="RemoveBorder" Background="{TemplateBinding Background}" CornerRadius="3">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="RemoveBorder" Property="Background" Value="#FBEAEA"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="PathTextBoxStyle" TargetType="TextBox">
            <Setter Property="Height" Value="32"/>
            <Setter Property="Padding" Value="9,0"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Background" Value="#FAFBFC"/>
            <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
            <Setter Property="BorderBrush" Value="#CDD3DA"/>
            <Setter Property="BorderThickness" Value="1"/>
        </Style>
    </Window.Resources>

    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <GroupBox Grid.Row="0" Header="Добавить модели Revit"
                  Style="{StaticResource CardGroupBoxStyle}" Margin="0,0,0,9">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <Button Grid.Column="0" Content="Revit Server" Style="{StaticResource ToolbarButtonStyle}" Click="RevitServer_Click"/>
                <Button Grid.Column="1" Content="Из директории" Style="{StaticResource ToolbarButtonStyle}" Click="AddRvtFiles_Click"/>
                <Button Grid.Column="2" Content="Добавить папку" Style="{StaticResource ToolbarButtonStyle}" Click="AddRvtFolder_Click"/>
                <Button Grid.Column="3" Width="34" MinWidth="34" Margin="0" Padding="0"
                        ToolTip="Очистить список" FontFamily="Segoe MDL2 Assets" FontSize="14"
                        Foreground="#C0392B" Content="&#xE74D;" Style="{StaticResource ButtonBaseStyle}" Click="ClearList"/>
            </Grid>
        </GroupBox>

        <Border Grid.Row="1" Margin="0,0,0,9" Background="White"
                BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="5">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <Border Padding="12,8" Background="#F8F9FA" BorderBrush="{StaticResource BorderBrush}"
                        BorderThickness="0,0,0,1" CornerRadius="5,5,0,0">
                    <TextBlock Text="Файлы для обработки" FontWeight="SemiBold" Foreground="{StaticResource TextBrush}"/>
                </Border>
                <ListBox x:Name="RvtFilesListBox" Grid.Row="1" Margin="4" Padding="4"
                         Background="White" BorderThickness="0" HorizontalContentAlignment="Stretch"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                    <ListBox.ItemContainerStyle>
                        <Style TargetType="ListBoxItem">
                            <Setter Property="Padding" Value="7,4"/>
                            <Setter Property="Margin" Value="0,0,0,2"/>
                            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                            <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
                            <Setter Property="Background" Value="Transparent"/>
                            <Setter Property="BorderThickness" Value="0"/>
                            <Style.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter Property="Background" Value="#F2F6F9"/>
                                </Trigger>
                                <Trigger Property="IsSelected" Value="True">
                                    <Setter Property="Background" Value="#EAF2F8"/>
                                    <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
                                </Trigger>
                            </Style.Triggers>
                        </Style>
                    </ListBox.ItemContainerStyle>
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Grid HorizontalAlignment="Stretch">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Margin="0,0,10,0" VerticalAlignment="Center"
                                           Text="{Binding}" TextTrimming="CharacterEllipsis" ToolTip="{Binding}"/>
                                <Button Grid.Column="1" Content="×" ToolTip="Удалить файл"
                                        Style="{StaticResource RemoveButtonStyle}" Click="RemoveRvtFile_Click"/>
                            </Grid>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </Grid>
        </Border>

        <GroupBox Grid.Row="2" Header="Операции" Style="{StaticResource CardGroupBoxStyle}" Margin="0,0,0,9">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="145"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <Button Grid.Row="0" Grid.Column="0" Margin="0,0,10,8" Content="Выбор файла XML"
                        Style="{StaticResource PathButtonStyle}" Click="SelectXmlFile_Click"/>
                <TextBox x:Name="XmlFilePath" Grid.Row="0" Grid.Column="1" Margin="0,0,10,8"
                         IsReadOnly="True" Style="{StaticResource PathTextBoxStyle}"/>
                <Button Grid.Row="0" Grid.Column="2" Margin="0,0,0,8" Content="Загрузить коллизии"
                        Style="{StaticResource DangerButtonStyle}" Click="StartProcessing_Click"/>

                <Button Grid.Row="1" Grid.Column="0" Margin="0,0,10,8" Content="Папка для RVT"
                        Style="{StaticResource PathButtonStyle}" Click="SelectRVTPath_Click"/>
                <Grid Grid.Row="1" Grid.Column="1" Margin="0,0,10,8">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                    <TextBox x:Name="RvtFilePath" IsReadOnly="True" Style="{StaticResource PathTextBoxStyle}"/>
                    <Button Grid.Column="1" Margin="5,0,0,0" Content="&#xE713;" ToolTip="Параметры экспорта RVT"
                            Style="{StaticResource SettingsButtonStyle}" Click="RvtPrefClick"/>
                </Grid>
                <Button Grid.Row="1" Grid.Column="2" Margin="0,0,0,8" Content="Экспорт RVT"
                        Style="{StaticResource ExecuteButtonStyle}" Click="ExportRVT_Click"/>

                <Button Grid.Row="2" Grid.Column="0" Margin="0,0,10,8" Content="Папка для NWC"
                        Style="{StaticResource PathButtonStyle}" Click="SelectNWCPath_Click"/>
                <Grid Grid.Row="2" Grid.Column="1" Margin="0,0,10,8">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                    <TextBox x:Name="NwcFilePath" IsReadOnly="True" Style="{StaticResource PathTextBoxStyle}"/>
                    <Button Grid.Column="1" Margin="5,0,0,0" Content="&#xE713;" ToolTip="Параметры экспорта NWC"
                            Style="{StaticResource SettingsButtonStyle}" Click="WorsetPrefClick"/>
                </Grid>
                <Button Grid.Row="2" Grid.Column="2" Margin="0,0,0,8" Content="Экспорт NWC"
                        Style="{StaticResource ExecuteButtonStyle}" Click="ExportNWC_Click"/>

                <Button Grid.Row="3" Grid.Column="0" Margin="0,0,10,8" Content="Папка для IFC"
                        Style="{StaticResource PathButtonStyle}" Click="SelectIFCPath_Click"/>
                <Grid Grid.Row="3" Grid.Column="1" Margin="0,0,10,8">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                    <TextBox x:Name="IfcFilePath" IsReadOnly="True" Style="{StaticResource PathTextBoxStyle}"/>
                    <Button Grid.Column="1" Margin="5,0,0,0" Content="&#xE713;" ToolTip="Параметры экспорта IFC"
                            Style="{StaticResource SettingsButtonStyle}" Click="IfcPrefClick"/>
                </Grid>
                <Button Grid.Row="3" Grid.Column="2" Margin="0,0,0,8" Content="Экспорт IFC"
                        Style="{StaticResource ExecuteButtonStyle}" Click="ExportIFC_Click"/>

                <Button Grid.Row="4" Grid.Column="0" Margin="0,0,10,0" Content="Файл семейства"
                        Style="{StaticResource PathButtonStyle}" Click="SelectRfaFile_Click"/>
                <Grid Grid.Row="4" Grid.Column="1" Margin="0,0,10,0">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                    <TextBox x:Name="rfaFilePath" IsReadOnly="True" Style="{StaticResource PathTextBoxStyle}"/>
                    <CheckBox x:Name="ReplaceParameters" Grid.Column="1" Margin="10,0,0,0"
                              VerticalAlignment="Center" IsChecked="False" Foreground="{StaticResource MutedTextBrush}"
                              Checked="ReplaceParameters_Checked">
                        <TextBlock Text="С заменой параметров"/>
                    </CheckBox>
                </Grid>
                <Button Grid.Row="4" Grid.Column="2" Content="Загрузить семейства"
                        Style="{StaticResource ButtonBaseStyle}" FontWeight="SemiBold" Click="Download_Click"/>
            </Grid>
        </GroupBox>

        <Border Grid.Row="3" Padding="10,8" Background="#F0F2F4"
                BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="5">
            <Grid>
                <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                <Button Grid.Column="0" Margin="0,0,8,0" Content="Удалить связи"
                        Style="{StaticResource ButtonBaseStyle}" Click="LinkRemove_Click"/>
                <Button Grid.Column="1" Content="Добавить параметры"
                        Style="{StaticResource ButtonBaseStyle}" Click="ParameterTools_Click"/>
                <TextBlock Grid.Column="2" HorizontalAlignment="Right" VerticalAlignment="Center"
                           Foreground="{StaticResource MutedTextBrush}" FontStyle="Italic"
                           Text="Выберите модели и нужную операцию"/>
            </Grid>
        </Border>
    </Grid>
</Window>
