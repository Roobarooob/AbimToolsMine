<?xml version="1.0" encoding="utf-8"?>
<Window x:Class="AbimToolsMine.ProgressWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="&#x41E;&#x431;&#x440;&#x430;&#x431;&#x43E;&#x442;&#x43A;&#x430;..."
   Width="420" Height="110"
        ResizeMode="NoResize"
        WindowStyle="SingleBorderWindow"
    WindowStartupLocation="CenterScreen"
        Background="WhiteSmoke"
        Topmost="True"
        ShowInTaskbar="False">
    <Grid Margin="12,10,12,10">
    <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="8"/>
   <RowDefinition Height="Auto"/>
            <RowDefinition Height="6"/>
       <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

   <TextBlock x:Name="TbLabel" Grid.Row="0"
       FontWeight="SemiBold" FontSize="12"
        TextTrimming="CharacterEllipsis"
         Text="&#x41F;&#x43E;&#x434;&#x433;&#x43E;&#x442;&#x43E;&#x432;&#x43A;&#x430;..."/>

        <ProgressBar x:Name="Pb" Grid.Row="2"
      Height="18" Minimum="0" Maximum="100"
   Foreground="#4CAF50"/>

        <TextBlock x:Name="TbPercent" Grid.Row="4"
           HorizontalAlignment="Right"
       Foreground="Gray" FontSize="11"
             Text="0%"/>
    </Grid>
</Window>
