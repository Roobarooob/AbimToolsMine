<Window x:Class="AbimToolsMine.IfcExportPrefWin"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Параметры экспорта IFC" Height="230" Width="620" MinWidth="520"
        Background="WhiteSmoke" Closing="Window_Closing" WindowStartupLocation="CenterOwner">
    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Label Grid.Row="0" Content="JSON-конфигурация экспорта IFC" Margin="0,0,0,5"/>
        <Grid Grid.Row="1" Margin="0,0,0,10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBox x:Name="IfcConfigTextBox" Height="30" Margin="0,0,5,0"
                     VerticalContentAlignment="Center" TextChanged="IfcConfigTextBox_TextChanged"/>
            <Button Grid.Column="1" Width="90" Height="30" Content="Обзор..." Click="SelectIfcConfig_Click"/>
        </Grid>

        <Label Grid.Row="2" Content="Подстрока имени 3D-вида (если конфигурация экспортирует текущий вид)" Margin="0,0,0,5"/>
        <TextBox x:Name="IfcViewNameTextBox" Grid.Row="3" Margin="0,0,0,10" Height="30"
                 VerticalContentAlignment="Center" TextChanged="IfcViewNameTextBox_TextChanged"/>
    </Grid>
</Window>
