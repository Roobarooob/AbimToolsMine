<Window x:Class="AbimToolsMine.AlignBySheetsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Выравнивание по листам"
        Width="720"
        Height="620"
        MinWidth="620"
        MinHeight="520"
        ResizeMode="CanResizeWithGrip"
        WindowStartupLocation="CenterScreen"
        Background="WhiteSmoke"
        Topmost="True">
    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0"
                   Margin="0,0,0,10"
                   TextWrapping="Wrap"
                   Text="Выберите листы, эталонный лист, типы видов и две пересекающиеся оси. Viewport на выбранных листах будет сдвинут так, чтобы пересечение осей совпало с эталоном относительно листа."/>

        <GroupBox Grid.Row="1" Header="Листы" Margin="0,0,0,10">
            <Grid Margin="8">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <TextBox x:Name="SheetFilterBox"
                         Grid.Row="0"
                         Height="24"
                         Margin="0,0,0,6"
                         VerticalContentAlignment="Center"
                         TextChanged="SheetFilterBox_TextChanged"/>

                <ListBox x:Name="SheetsListBox"
                         Grid.Row="1"
                         SelectionMode="Extended">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <CheckBox Content="{Binding DisplayName}"
                                      IsChecked="{Binding IsChecked, Mode=TwoWay}"/>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>

                <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,8,0,0">
                    <Button Content="Выбрать все" Width="100" Margin="0,0,8,0" Click="SelectAll_Click"/>
                    <Button Content="Снять все" Width="100" Margin="0,0,8,0" Click="ClearAll_Click"/>
                    <TextBlock x:Name="SelectedCountText" VerticalAlignment="Center" Foreground="Gray"/>
                </StackPanel>
            </Grid>
        </GroupBox>

        <GroupBox Grid.Row="2" Header="Эталон и типы видов" Margin="0,0,0,10">
            <Grid Margin="8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0" Grid.Column="0" Text="Эталонный лист:" VerticalAlignment="Center" Margin="0,0,8,6"/>
                <ComboBox x:Name="ReferenceSheetComboBox"
                          Grid.Row="0"
                          Grid.Column="1"
                          Grid.ColumnSpan="3"
                          DisplayMemberPath="DisplayName"
                          Margin="0,0,0,6"/>

                <TextBlock Grid.Row="1" Grid.Column="0" Text="Обрабатывать:" VerticalAlignment="Center" Margin="0,0,8,0"/>
                <CheckBox x:Name="FloorPlansCheckBox" Grid.Row="1" Grid.Column="1" Content="Планы этажей" IsChecked="True"/>
                <CheckBox x:Name="CeilingPlansCheckBox" Grid.Row="1" Grid.Column="2" Content="Планы потолков" Margin="16,0,0,0"/>
            </Grid>
        </GroupBox>

        <GroupBox Grid.Row="3" Header="Опорные оси" Margin="0,0,0,10">
            <Grid Margin="8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="120"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="120"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Column="0" Text="Ось 1:" VerticalAlignment="Center" Margin="0,0,8,0"/>
                <TextBox x:Name="FirstGridBox" Grid.Column="1" Text="А" Height="24" VerticalContentAlignment="Center"/>
                <TextBlock Grid.Column="2" Text="Ось 2:" VerticalAlignment="Center" Margin="16,0,8,0"/>
                <TextBox x:Name="SecondGridBox" Grid.Column="3" Text="1" Height="24" VerticalContentAlignment="Center"/>
                <TextBlock Grid.Column="4"
                           Text="Например: А и 1"
                           VerticalAlignment="Center"
                           Margin="12,0,0,0"
                           Foreground="Gray"/>
            </Grid>
        </GroupBox>

        <StackPanel Grid.Row="4" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="Выполнить" Width="100" Height="28" Margin="0,0,8,0" Click="Ok_Click"/>
            <Button Content="Отмена" Width="100" Height="28" Click="Cancel_Click"/>
        </StackPanel>
    </Grid>
</Window>
